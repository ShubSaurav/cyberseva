# CyberSeva Backend Configuration

# Server Port (default: 5001)
PORT=5001

# Environment
NODE_ENV=production

# Host interface to bind to (0.0.0.0 binds to all network interfaces for container & LAN support)
HOST=0.0.0.0

# CORS Allowed Origins (* for wildcard, or specific domain https://your-cyberseva-app.com)
CORS_ORIGIN=*

# Storage Directory for Persistent Database
DATA_DIR=./data

# Print Bridge Settings
PRINT_BRIDGE_HOST=127.0.0.1
PRINT_BRIDGE_PORT=9100
