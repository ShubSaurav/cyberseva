# CyberSeva Environment Configuration (Root / Fullstack)

# Node Environment ('production' | 'development')
NODE_ENV=production

# Server Port
PORT=5001

# Allowed CORS Origins (use '*' for any, or comma-separated domains: https://cyberseva.in,https://app.cyberseva.in)
CORS_ORIGIN=*

# Storage Directory for JSON Database & Spooler
DATA_DIR=./backend/data

# Windows Print Bridge Configuration
PRINT_BRIDGE_HOST=127.0.0.1
PRINT_BRIDGE_PORT=9100

# Frontend API URL (if frontend and backend are hosted on separate domains)
# VITE_API_URL=https://api.cyberseva.in
